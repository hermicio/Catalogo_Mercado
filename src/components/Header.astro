---
import type { Role } from '../lib/types';

interface Props {
  user: Awaited<ReturnType<typeof import('../lib/supabase').getUser>>['data']['user'] | null;
  role: Role;
}

const { user, role } = Astro.props as Props;

const dashboardHref = role === 'admin' ? '/admin/dashboard' : '/misnegocios';
---

<header class="sticky top-0 z-40 border-b border-gray-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a href="/" class="flex items-center gap-2 text-lg font-bold text-gray-900">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-emerald-600 text-white">📦</span>
      <span>Catálogos del Local</span>
    </a>

    <nav class="flex items-center gap-4">
      {user ? (
        <>
          <a href={dashboardHref} class="rounded-lg px-3 py-2 text-sm font-medium text-gray-600 hover:bg-gray-100">
            Mi panel
          </a>
          <span class="hidden text-sm text-gray-400 sm:block">{user.email}</span>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="rounded-lg border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100">
              Cerrar sesión
            </button>
          </form>
        </>
      ) : (
        <>
          <a href="/login" class="rounded-lg px-3 py-2 text-sm font-medium text-gray-600 hover:bg-gray-100">
            Iniciar sesión
          </a>
          <a href="/registro" class="rounded-lg bg-emerald-600 px-3 py-2 text-sm font-medium text-white hover:bg-emerald-700">
            Registrarse
          </a>
        </>
      )}
    </nav>
  </div>
</header>
