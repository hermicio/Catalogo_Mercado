---
import '../styles/global.css';
import { getRole } from '../lib/types';
import Header from '../components/Header.astro';

const { title, description } = Astro.props as {
  title?: string;
  description?: string;
};

const user = Astro.locals.user;
const role = getRole(user);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? 'Catálogos de los negocios del local'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} · ` : ''}Catálogos del Local</title>
  </head>
  <body class="min-h-screen bg-gray-50">
    <Header user={user} role={role} />
    <main>
      <slot />
    </main>
    <footer class="border-t border-gray-200 bg-white py-8 mt-16">
      <div class="mx-auto max-w-6xl px-4 text-center text-sm text-gray-500">
        © {new Date().getFullYear()} Catálogos del Local · Todos los derechos reservados
      </div>
    </footer>
  </body>
</html>
