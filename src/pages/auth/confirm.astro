---
import Layout from '../../layouts/Layout.astro';

const SUPABASE_URL = import.meta.env.SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.SUPABASE_ANON_KEY;
const error = Astro.url.searchParams.get('error') ?? 'Procesando confirmaci\u00f3n de tu correo...';
---

<Layout title="Confirmar correo">
  <div class="mx-auto max-w-md px-4 py-16">
    <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm text-center">
      <h1 class="text-2xl font-bold text-gray-900">Confirmando tu correo</h1>
      <p id="estado" class="mt-4 text-sm text-gray-600">{error}</p>
    </div>
  </div>
</Layout>

<script define:vars={{ supabaseUrl: SUPABASE_URL, supabaseAnonKey: SUPABASE_ANON_KEY }}>
  import { createClient } from '@supabase/supabase-js';

  (async () => {
    const estado = document.getElementById('estado');
    if (!estado) return;

    const supabase = createClient(supabaseUrl, supabaseAnonKey);
    const url = new URL(window.location.href);

    let tokenHash = url.searchParams.get('token_hash');
    let type = url.searchParams.get('type');
    let next = url.searchParams.get('next') ?? '/misnegocios';

    if (url.hash.length > 1) {
      const hashParams = new URLSearchParams(url.hash.slice(1));
      if (!tokenHash) tokenHash = hashParams.get('token_hash');
      if (!type) type = hashParams.get('type');
      if (!next) next = hashParams.get('next') ?? '/misnegocios';
    }

    if (!tokenHash || !type) {
      estado.textContent =
        'El enlace de confirmaci\u00f3n es inv\u00e1lido o ya expir\u00f3. Solicita un nuevo enlace o vuelve a registrarte.';
      return;
    }

    const { error } = await supabase.auth.verifyOtp({ token_hash: tokenHash, type });

    if (error) {
      estado.textContent =
        'No se pudo confirmar tu correo: ' + (error.message || 'enlace no v\u00e1lido o expirado.');
      return;
    }

    window.location.href = next;
  })();
</script>
