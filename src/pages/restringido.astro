---
import Layout from '../layouts/Layout.astro';

const email = Astro.url.searchParams.get('email') ?? '';
const error = Astro.url.searchParams.get('error');
const enviado = Astro.url.searchParams.get('enviado');
---

<Layout title="Acceso restringido">
  <div class="mx-auto max-w-md px-4 py-16">
    <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
      <div class="text-center">
        <div class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-red-100 text-2xl">&#128274;</div>
        <h1 class="mt-4 text-2xl font-bold text-gray-900">Acceso restringido</h1>
        <p class="mt-3 text-sm text-gray-600">
          Tu cuenta fue dada de baja o su acceso está <strong>restringido</strong> por el administrador de la feria.
          Por este motivo no podés ingresar al panel.
        </p>
        <p class="mt-2 text-sm text-gray-600">
          Si creés que es un error, comunicate con el administrador dejando un mensaje a continuación.
        </p>
      </div>

      {error && <div class="mt-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{error}</div>}
      {enviado && (
        <div class="mt-4 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
          Mensaje enviado. El administrador lo recibirá y se pondrá en contacto. Gracias.
        </div>
      )}

      <form method="POST" action="/api/messages/create" class="mt-6 space-y-4">
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700">Tu correo electrónico</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            value={email}
            class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500"
          />
        </div>
        <div>
          <label for="subject" class="block text-sm font-medium text-gray-700">Asunto</label>
          <input
            type="text"
            id="subject"
            name="subject"
            required
            placeholder="Ej. Quiero recuperar mi acceso"
            class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500"
          />
        </div>
        <div>
          <label for="message" class="block text-sm font-medium text-gray-700">Mensaje</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            placeholder="Contanos qué pasó y por qué necesitás recuperar el acceso..."
            class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500"
          ></textarea>
        </div>
        <button
          type="submit"
          class="w-full rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700"
        >
          Enviar mensaje al administrador
        </button>
      </form>

      <p class="mt-6 text-center text-sm text-gray-500">
        <a href="/login" class="font-medium text-emerald-600 hover:underline">Volver a iniciar sesión</a>
      </p>
    </div>
  </div>
</Layout>
