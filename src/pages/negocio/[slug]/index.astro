---
import Layout from '../../../layouts/Layout.astro';
import type { Business, Catalog, Product } from '../../../lib/types';

interface Props {
  slug: string;
}

const { slug } = Astro.params as unknown as Props;
const sb = Astro.locals.supabase;

const { data: business, error } = await sb
  .from('businesses')
  .select('*')
  .eq('slug', slug)
  .eq('is_visible', true)
  .single();

if (error || !business) {
  return Astro.redirect('/');
}

const b = business as Business;

const { data: catalogs } = await sb
  .from('catalogs')
  .select('*')
  .eq('business_id', b.id)
  .eq('is_visible', true)
  .order('sort_order', { ascending: true });

const { data: products } = await sb
  .from('products')
  .select('*')
  .eq('business_id', b.id)
  .eq('is_visible', true)
  .order('sort_order', { ascending: true })
  .order('created_at', { ascending: false });

const fmt = (n: number) => '$' + Number(n).toLocaleString('es-AR', { minimumFractionDigits: 2 });

const waNumber = b.whatsapp?.replace(/[^0-9]/g, '') ?? '';
const waText = encodeURIComponent(
  (b.whatsapp_message && b.whatsapp_message.trim()) || 'Hola! Visité tu emprendimiento en la feria y quería consultarte por tus productos.'
);
const waEnabled = waNumber.length >= 8;
const socials = (Array.isArray(b.social_links) ? b.social_links : [])
  .filter((s) => s && typeof s === 'object' && typeof s.url === 'string' && s.url.trim())
  .map((s) => ({ label: s.label ?? '', url: s.url as string }));
---

<Layout title={b.name}>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <nav class="mb-6 text-sm text-gray-500">
      <a href="/" class="hover:text-emerald-600">Inicio</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{b.name}</span>
    </nav>

    <div class="overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-sm">
      {b.cover_url ? (
        <div class="aspect-[21/9] w-full overflow-hidden bg-gray-100">
          <img src={b.cover_url} alt={b.name} class="h-full w-full object-cover" />
        </div>
      ) : (
        <div class="aspect-[21/9] w-full overflow-hidden bg-gradient-to-r from-emerald-500 to-teal-500"></div>
      )}

      <div class="p-6 sm:p-8">
        <h1 class="text-3xl font-bold text-gray-900">{b.name}</h1>
        {b.description && <p class="mt-3 text-gray-600">{b.description}</p>}

        <dl class="mt-6 grid gap-4 text-sm sm:grid-cols-2">
          {b.address && (
            <div>
              <dt class="font-semibold text-gray-900">Ubicación</dt>
              <dd class="mt-1 text-gray-600">{b.address}</dd>
            </div>
          )}
          {b.schedule && (
            <div>
              <dt class="font-semibold text-gray-900">Horario</dt>
              <dd class="mt-1 text-gray-600">{b.schedule}</dd>
            </div>
          )}
          {b.phone && (
            <div>
              <dt class="font-semibold text-gray-900">Teléfono</dt>
              <dd class="mt-1 text-gray-600">{b.phone}</dd>
            </div>
          )}
        </dl>

        {(waEnabled || socials.length > 0) && (
          <div class="mt-6 flex flex-wrap items-center gap-3 border-t border-gray-100 pt-6">
            {waEnabled && (
              <a
                href={`https://wa.me/${waNumber}?text=${waText}`}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-full bg-emerald-500 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-600"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                </svg>
                Hablar por WhatsApp
              </a>
            )}
            {socials.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-full border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:border-emerald-500 hover:text-emerald-600"
              >
                {s.label || 'Red social'}
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5h5v5M19 5l-9 9m5-13a2 2 0 100 4h1a2 2 0 002-2V4z" />
                </svg>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>

    <section class="mt-10">
      <h2 class="text-2xl font-bold text-gray-900">Catálogos</h2>
      {catalogs && catalogs.length > 0 ? (
        <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {(catalogs as Catalog[]).map((c) => (
            <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
              <div class="aspect-[3/4] w-full overflow-hidden bg-gray-100">
                {c.thumbnail_url ? (
                  <img src={c.thumbnail_url} alt={c.title} class="h-full w-full object-cover" loading="lazy" />
                ) : (
                  <div class="grid h-full w-full place-items-center bg-gray-100 text-gray-400">
                    <svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                  </div>
                )}
              </div>
              <div class="p-4">
                <h3 class="font-semibold text-gray-900">{c.title}</h3>
                <div class="mt-3 flex gap-2">
                  <a
                    href={`/negocio/${b.slug}/catalogo/${c.id}`}
                    class="flex-1 rounded-lg bg-emerald-600 px-3 py-2 text-center text-sm font-medium text-white hover:bg-emerald-700"
                  >
                    Ver en línea
                  </a>
                  <a
                    href={c.pdf_url}
                    target="_blank"
                    rel="noopener"
                    download
                    class="flex-1 rounded-lg border border-gray-300 px-3 py-2 text-center text-sm font-medium text-gray-700 hover:bg-gray-100"
                  >
                    Descargar PDF
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="mt-6 text-gray-500">Este negocio aún no tiene catálogos disponibles.</p>
      )}
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-bold text-gray-900">Productos a la venta</h2>
      {products && products.length > 0 ? (
        <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {(products as Product[]).map((p) => (
            <div class={`overflow-hidden rounded-2xl bg-white shadow-sm ${p.on_sale ? 'border-2 border-red-400 ring-2 ring-red-100' : 'border border-gray-200'}`}>
              <div class="aspect-square w-full overflow-hidden bg-gray-100">
                {p.image_url ? (
                  <img src={p.image_url} alt={p.name} class="h-full w-full object-cover" loading="lazy" />
                ) : (
                  <div class="grid h-full w-full place-items-center bg-gray-100 text-gray-400">🛍️</div>
                )}
              </div>
              <div class="p-4">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-semibold text-gray-900">{p.name}</h3>
                  {p.on_sale && (
                    <span class="rounded-full bg-red-600 px-2 py-0.5 text-xs font-semibold text-white">¡En liquidación!</span>
                  )}
                </div>
                <p class={`mt-1 text-lg font-bold ${p.on_sale ? 'text-red-600' : 'text-emerald-700'}`}>{fmt(p.price)}</p>
                {p.description && <p class="mt-2 text-sm text-gray-600">{p.description}</p>}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="mt-6 text-gray-500">Este negocio aún no tiene productos en venta.</p>
      )}
    </section>
  </div>
</Layout>
