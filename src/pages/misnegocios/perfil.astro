---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getRole } from '../../lib/types';

const user = Astro.locals.user;
const role = getRole(user);
---

<DashboardLayout title="Perfil" role={role} active="/misnegocios/perfil">
  <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
    <dl class="space-y-4 text-sm">
      <div>
        <dt class="font-medium text-gray-900">Correo electrónico</dt>
        <dd class="mt-1 text-gray-600">{user?.email}</dd>
      </div>
      <div>
        <dt class="font-medium text-gray-900">Rol</dt>
        <dd class="mt-1 text-gray-600">{role === 'admin' ? 'Administrador' : 'Puestero'}</dd>
      </div>
      <div>
        <dt class="font-medium text-gray-900">ID de usuario</dt>
        <dd class="mt-1 break-all text-gray-500">{user?.id}</dd>
      </div>
    </dl>
  </div>
</DashboardLayout>
