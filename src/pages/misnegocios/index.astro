---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getRole } from '../../lib/types';
import type { Business } from '../../lib/types';

const sb = Astro.locals.supabase;
const user = Astro.locals.user;
const role = getRole(user);

const { data: businesses } = await sb
  .from('businesses')
  .select('*')
  .eq('owner_id', user!.id);
---

<DashboardLayout title="Mi negocio" role={role} active="/misnegocios">
  {businesses && businesses.length > 0 ? (
    <div class="space-y-4">
      {(businesses as Business[]).map((b) => (
        <div class="flex items-center gap-4 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="h-20 w-20 shrink-0 overflow-hidden rounded-xl bg-gray-100">
            {b.image_url ? (
              <img src={b.image_url} alt={b.name} class="h-full w-full object-cover" />
            ) : (
              <div class="grid h-full w-full place-items-center text-gray-400">📷</div>
            )}
          </div>
          <div class="min-w-0 flex-1">
            <h2 class="font-semibold text-gray-900">{b.name}</h2>
            <p class="text-sm text-gray-500">
              {b.is_visible ? 'Publicado' : 'Pendiente de aprobación'}
            </p>
          </div>
          <a
            href={`/misnegocios/editar/${b.slug}`}
            class="rounded-lg bg-emerald-600 px-3 py-2 text-sm font-medium text-white hover:bg-emerald-700"
          >
            Editar
          </a>
        </div>
      ))}
    </div>
  ) : (
    <div class="rounded-2xl border border-dashed border-gray-300 bg-white p-8 text-center">
      <p class="text-gray-500">Aún no tienes un negocio asociado. Contacta al administrador.</p>
    </div>
  )}
</DashboardLayout>
