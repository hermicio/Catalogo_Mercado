---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getRole } from '../../lib/types';
import type { Business } from '../../lib/types';

const sb = Astro.locals.supabase;
const user = Astro.locals.user;
const role = getRole(user);

const { data: myBusinesses } = await sb
  .from('businesses')
  .select('id, name, products_auto_visible')
  .eq('owner_id', user!.id);

const businesses = (myBusinesses ?? []) as (Business & { products_auto_visible?: boolean })[];
const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
---

<DashboardLayout title="Carga masiva de productos" role={role} active="/misnegocios/productos">
  {ok && (
    <div class="mb-4 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
      {ok} producto(s) cargados correctamente.
    </div>
  )}
  {error && <div class="mb-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{error}</div>}

  {businesses.length > 0 ? (
    <form method="POST" action="/api/products/bulk" enctype="multipart/form-data" class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="font-semibold text-gray-900">Carga masiva de productos</h2>

      <div class="mt-4">
        <label class="block text-sm font-medium text-gray-700">Negocio</label>
        <select name="business_id" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2">
          {businesses.map((b) => (
            <option value={b.id}>{b.name}</option>
          ))}
        </select>
      </div>

      <div class="mt-4">
        <label class="block text-sm font-medium text-gray-700">Lista de productos</label>
        <textarea name="bulk" rows="12" required placeholder={'Pan integral;Pan de masa madre;2500\nCafe molido;Paquete de 500g;1500\nMermelada de frutilla;Frasco 400g;3000'} class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 font-mono text-sm"></textarea>
      </div>

      <div class="mt-4 rounded-xl bg-gray-50 p-4 text-sm text-gray-600">
        <p class="font-semibold text-gray-900">Cómo cargar los productos</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>
            Escribí <strong>una línea por producto</strong> con el formato:
            <code class="rounded bg-gray-200 px-1 py-0.5 text-xs">Nombre;Descripción;Precio</code>
          </li>
          <li>Los campos se separan con <strong>punto y coma (;)</strong>.</li>
          <li>
            Ejemplo:
            <pre class="mt-1 whitespace-pre-wrap rounded-lg bg-white p-3 text-xs text-gray-800">Pan integral;Pan de masa madre;2500
Cafe molido;Paquete de 500g;1500
Mermelada de frutilla;Frasco 400g;3000</pre>
          </li>
          <li>La <strong>descripción es opcional</strong>: podés cargar solo <code class="rounded bg-gray-200 px-1 py-0.5 text-xs">Nombre;Precio</code>.</li>
          <li>El <strong>precio</strong> debe ser un número (usá punto para decimales, ej. 1500.50).</li>
          <li>Las líneas vacías se ignoran.</li>
          <li>
            Si querés que aparezca al instante, el negocio elegido debe tener la <strong>publicación automática</strong> activa; si no, los productos quedan pendientes de aprobación del administrador.
          </li>
        </ul>
      </div>

      <button type="submit" class="mt-4 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">
        Cargar productos
      </button>
    </form>
  ) : (
    <p class="rounded-2xl border border-gray-200 bg-white p-8 text-center text-gray-500">Primero debes tener un negocio asociado para cargar productos.</p>
  )}

  <a href="/misnegocios/productos" class="mt-4 inline-block text-sm text-emerald-600 hover:underline">← Volver a Mis productos</a>
</DashboardLayout>