---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getRole } from '../../lib/types';
import type { Business, Catalog } from '../../lib/types';

const sb = Astro.locals.supabase;
const user = Astro.locals.user;
const role = getRole(user);

const { data: myBusinesses } = await sb
  .from('businesses')
  .select('*')
  .eq('owner_id', user!.id);

const businesses = (myBusinesses ?? []) as Business[];
const ids = businesses.map((b) => b.id);

const { data: catalogs } = ids.length
  ? await sb.from('catalogs').select('*').in('business_id', ids).order('created_at', { ascending: false })
  : { data: [] };

const catalogsList = (catalogs ?? []) as Catalog[];
const error = Astro.url.searchParams.get('error');
---

<DashboardLayout title="Mis catálogos" role={role} active="/misnegocios/catalogos">
  {error && <div class="mb-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{error}</div>}

  {businesses.length > 0 ? (
    <form method="POST" action="/api/catalogs/create" enctype="multipart/form-data" class="mb-8 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="mb-4 font-semibold text-gray-900">Subir nuevo catálogo</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="block text-sm font-medium text-gray-700">Negocio</label>
          <select name="business_id" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2">
            {businesses.map((b) => (
              <option value={b.id}>{b.name}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Título del catálogo</label>
          <input name="title" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Archivo PDF</label>
          <input type="file" name="pdf" accept="application/pdf" required class="mt-1 w-full text-sm" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Miniatura (opcional)</label>
          <input type="file" name="thumbnail" accept="image/*" class="mt-1 w-full text-sm" />
        </div>
      </div>
      <div class="mt-4 text-sm text-gray-500">
        Nota: los catálogos subidos por puesteros quedan <strong>pendientes de aprobación</strong> por el administrador.
      </div>
      <button type="submit" class="mt-4 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">
        Subir catálogo
      </button>
    </form>
  ) : (
    <p class="mb-6 text-gray-500">Primero debes tener un negocio asociado para subir catálogos.</p>
  )}

  {catalogsList.length > 0 ? (
    <div class="space-y-3">
      {catalogsList.map((c) => (
        <div class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="flex-1">
            <p class="font-medium text-gray-900">{c.title}</p>
            <p class="text-sm text-gray-500">
              {c.is_visible ? 'Publicado' : 'Pendiente de aprobación'}
            </p>
          </div>
          <form method="POST" action="/api/catalogs/delete" onsubmit="return confirm('¿Eliminar este catálogo?')">
            <input type="hidden" name="id" value={c.id} />
            <button type="submit" class="rounded-lg border border-red-200 px-3 py-1.5 text-sm text-red-600 hover:bg-red-50">
              Eliminar
            </button>
          </form>
        </div>
      ))}
    </div>
  ) : (
    <p class="text-gray-500">No tienes catálogos todavía.</p>
  )}
</DashboardLayout>
