---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import type { Business, Catalog } from '../../lib/types';

const sb = Astro.locals.supabase;

const { data: rows } = await sb
  .from('catalogs')
  .select('*, businesses(name, slug)')
  .order('created_at', { ascending: false });
const error = Astro.url.searchParams.get('error');

const catalogs = (rows ?? []) as unknown as (Catalog & { businesses: Business })[];
const pending = catalogs.filter((c) => !c.is_visible);
const published = catalogs.filter((c) => c.is_visible);
---

<DashboardLayout title="Aprobar catálogos" role="admin" active="/admin/catalogos">
  {error && <div class="mb-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{error}</div>}

  <section class="mb-8">
    <h2 class="mb-4 font-semibold text-gray-900">Pendientes de aprobación ({pending.length})</h2>
    {pending.length > 0 ? (
      <div class="space-y-3">
        {pending.map((c) => (
          <div class="flex flex-wrap items-center gap-4 rounded-xl border border-amber-200 bg-amber-50 p-4">
            <div class="min-w-0 flex-1">
              <p class="font-medium text-gray-900">{c.title}</p>
              <p class="text-sm text-gray-600">Negocio: {c.businesses?.name}</p>
              <a href={c.pdf_url} target="_blank" class="text-sm text-emerald-600 hover:underline">Ver PDF</a>
            </div>
            <div class="flex gap-2">
              <form method="POST" action="/api/admin/catalogs/setvisible">
                <input type="hidden" name="id" value={c.id} />
                <input type="hidden" name="visible" value="true" />
                <button type="submit" class="rounded-lg bg-emerald-600 px-3 py-1.5 text-sm text-white hover:bg-emerald-700">Aprobar</button>
              </form>
              <form method="POST" action="/api/admin/catalogs/setvisible">
                <input type="hidden" name="id" value={c.id} />
                <input type="hidden" name="visible" value="false" />
                <button type="submit" class="rounded-lg border border-red-200 px-3 py-1.5 text-sm text-red-600 hover:bg-red-50">Rechazar</button>
              </form>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-gray-500">No hay catálogos pendientes.</p>
    )}
  </section>

  <section>
    <h2 class="mb-4 font-semibold text-gray-900">Publicados ({published.length})</h2>
    {published.length > 0 ? (
      <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500">Catálogo</th>
              <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500">Negocio</th>
              <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {published.map((c) => (
              <tr>
                <td class="px-4 py-3 text-sm font-medium text-gray-900">{c.title}</td>
                <td class="px-4 py-3 text-sm text-gray-600">{c.businesses?.name}</td>
                <td class="px-4 py-3 text-right">
                  <div class="flex justify-end gap-2">
                    <form method="POST" action="/api/admin/catalogs/setvisible">
                      <input type="hidden" name="id" value={c.id} />
                      <input type="hidden" name="visible" value="false" />
                      <button type="submit" class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-100">Ocultar</button>
                    </form>
                    <form method="POST" action="/api/catalogs/delete">
                      <input type="hidden" name="id" value={c.id} />
                      <button type="submit" class="rounded-lg border border-red-200 px-3 py-1.5 text-sm text-red-600 hover:bg-red-50">Eliminar</button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="text-gray-500">Aún no hay catálogos publicados.</p>
    )}
  </section>
</DashboardLayout>
