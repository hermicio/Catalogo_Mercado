---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import type { FairDate } from '../../lib/types';

const sb = Astro.locals.supabase;

const { data: rows } = await sb.from('fair_dates').select('*').order('fair_date', { ascending: true });
const ferias = (rows ?? []) as FairDate[];
const error = Astro.url.searchParams.get('error');

const today = new Date().toISOString().slice(0, 10);
const fmtDate = (iso: string) => new Date(iso + 'T12:00:00').toLocaleDateString('es-AR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
---

<DashboardLayout title="Fechas de ferias" role="admin" active="/admin/ferias">
  {error && <div class="mb-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{error}</div>}

  <form method="POST" action="/api/admin/ferias/create" class="mb-8 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="mb-4 font-semibold text-gray-900">Agregar fecha de feria</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="block text-sm font-medium text-gray-700">Fecha</label>
        <input type="date" name="fair_date" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Título (opcional)</label>
        <input name="title" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" placeholder="Feria del Local" />
      </div>
      <div class="sm:col-span-2">
        <label class="block text-sm font-medium text-gray-700">Descripción (opcional)</label>
        <textarea name="description" rows="2" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" placeholder="Detalles de la jornada"></textarea>
      </div>
    </div>
    <button type="submit" class="mt-4 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">
      Agregar fecha
    </button>
  </form>

  {ferias.length > 0 ? (
    <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500">Fecha</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500">Título</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500">Descripción</th>
            <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {ferias.map((f) => (
            <tr class={f.fair_date >= today ? 'bg-emerald-50/50' : ''}>
              <td class="px-4 py-3 text-sm font-medium text-gray-900">
                {fmtDate(f.fair_date)}
                {f.fair_date >= today && (
                  <span class="ml-2 rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">Próxima</span>
                )}
              </td>
              <td class="px-4 py-3 text-sm text-gray-600">{f.title ?? '—'}</td>
              <td class="px-4 py-3 text-sm text-gray-600">{f.description ?? '—'}</td>
              <td class="px-4 py-3 text-right">
                <form method="POST" action="/api/admin/ferias/delete" onsubmit="return confirm('¿Eliminar esta fecha?')">
                  <input type="hidden" name="id" value={f.id} />
                  <button type="submit" class="rounded-lg border border-red-200 px-3 py-1.5 text-sm text-red-600 hover:bg-red-50">Eliminar</button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p class="rounded-2xl border border-gray-200 bg-white p-8 text-center text-gray-500">Todavía no hay fechas de ferias cargadas.</p>
  )}
</DashboardLayout>