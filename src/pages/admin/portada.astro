---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import type { SiteSettings } from '../../lib/types';

const sb = Astro.locals.supabase;

const { data: settingsRow } = await sb.from('site_settings').select('*').eq('id', 1).maybeSingle();
const settings = settingsRow as SiteSettings | null;
const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
---

<DashboardLayout title="Página principal" role="admin" active="/admin/portada">
  {ok && <div class="mb-4 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Cambios guardados. La página principal se actualizó.</div>}
  {error && <div class="mb-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{error}</div>}

  <form method="POST" action="/api/admin/site/update" enctype="multipart/form-data" class="space-y-5 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="font-semibold text-gray-900">Portada de la página principal</h2>

    <div>
      <label class="block text-sm font-medium text-gray-700">Título principal</label>
      <input name="home_title" value={settings?.home_title ?? ''} class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" />
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700">Subtítulo</label>
      <textarea name="home_subtitle" rows="3" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2">{settings?.home_subtitle ?? ''}</textarea>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700">Imagen de fondo / portada (dejar vacío para conservar la actual)</label>
      <input type="file" name="image" accept="image/*" class="mt-1 w-full text-sm" />
    </div>

    {settings?.hero_image_url ? (
      <div class="flex items-end gap-4">
        <div class="overflow-hidden rounded-xl border border-gray-200">
          <img src={settings.hero_image_url} alt="Portada actual" class="max-h-40 w-auto object-cover" />
        </div>
        <label class="flex items-center gap-2 text-sm text-gray-600">
          <input type="checkbox" name="remove_image" class="h-4 w-4 rounded border-gray-300" />
          Quitar la imagen actual
        </label>
      </div>
    ) : (
      <p class="text-sm text-gray-500">No hay imagen de portada configurada.</p>
    )}

    <button type="submit" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">
      Guardar cambios
    </button>
  </form>

  <a href="/" class="mt-4 inline-block text-sm text-emerald-600 hover:underline">Ver la página principal →</a>
</DashboardLayout>