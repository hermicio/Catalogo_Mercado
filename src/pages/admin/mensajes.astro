---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const sb = Astro.locals.supabase;

const { data: messages, error } = await sb
  .from('user_messages')
  .select('*')
  .order('created_at', { ascending: false });

const errorParam = Astro.url.searchParams.get('error');
const ok = Astro.url.searchParams.get('ok');

const formatDate = (iso: string | null) =>
  iso
    ? new Date(iso).toLocaleString('es-AR', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      })
    : '';
---

<DashboardLayout title="Mensajes de usuarios" role="admin" active="/admin/mensajes">
  {errorParam && <div class="mb-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">No se pudo completar la acción.</div>}
  {ok && <div class="mb-4 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Mensaje actualizado.</div>}

  {messages && messages.length > 0 ? (
    <div class="space-y-3">
      {messages.map((m) => (
        <div class={`rounded-2xl border bg-white p-4 shadow-sm ${m.is_read ? 'border-gray-200' : 'border-emerald-300 ring-1 ring-emerald-100'}`}>
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-sm font-semibold text-gray-900">
                {m.subject}
                {!m.is_read && (
                  <span class="ml-2 rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">Nuevo</span>
                )}
              </p>
              <p class="mt-1 text-xs text-gray-500">
                {m.email} · {formatDate(m.created_at)}
              </p>
            </div>
            <div class="flex shrink-0 gap-2">
              <form method="POST" action="/api/admin/messages/toggle">
                <input type="hidden" name="id" value={m.id} />
                <button
                  type="submit"
                  class="rounded-lg border border-gray-300 px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50"
                >
                  {m.is_read ? 'Marcar no leído' : 'Marcar leído'}
                </button>
              </form>
              <form
                method="POST"
                action="/api/admin/messages/delete"
                onsubmit="return confirm('¿Eliminar este mensaje?')"
              >
                <input type="hidden" name="id" value={m.id} />
                <button
                  type="submit"
                  class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-medium text-red-700 hover:bg-red-50"
                >
                  Eliminar
                </button>
              </form>
            </div>
          </div>
          <p class="mt-3 whitespace-pre-wrap rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-700">{m.message}</p>
        </div>
      ))}
    </div>
  ) : (
    <div class="rounded-2xl border border-gray-200 bg-white p-8 text-center text-gray-500">
      No hay mensajes de usuarios todavía.
    </div>
  )}
</DashboardLayout>
