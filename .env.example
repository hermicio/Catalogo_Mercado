# Copiar a .env (solo local) y completar.
# En producción estas mismas variables se configuran en el hosting (Vercel/Netlify),
# NUNCA se suben al repositorio.

# URL del proyecto (local: http://127.0.0.1:54321 -- cloud: https://TU-PROYECTO.supabase.co)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública "anon" (Project Settings -> API keys -> anon public)
SUPABASE_ANON_KEY=tu-anon-key

# Clave "service_role" - SOLO para operaciones de administración (listar/asignar usuarios).
# ¡MANTENER EN SECRETO! Nunca exponerla en el frontend ni subirla al repo.
# Project Settings -> API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
